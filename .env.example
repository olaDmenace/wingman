# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration (for LLM)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key

# Flight API Configuration - AviationStack
# Register at: https://aviationstack.com (Free tier: 500 requests/month)
AVIATIONSTACK_API_KEY=your_aviationstack_api_key
# Set to 'mock' to force mock data, leave blank or any other value to use AviationStack API
FLIGHT_API_MODE=aviationstack

# Cron Job Secret (for securing the price alert check endpoint)
# Generate a random secret key for securing cron endpoints
CRON_SECRET=your_random_secret_key_here

# Email Service Configuration
# Wingman uses Supabase Edge Functions + Resend for email delivery
# See SUPABASE_EMAIL_SETUP.md for complete setup instructions
#
# Steps:
# 1. Sign up for Resend: https://resend.com
# 2. Get your API key from Resend dashboard
# 3. Deploy the email edge function:
#    npx supabase functions deploy send-email
# 4. Set the Resend API key as a Supabase secret:
#    npx supabase secrets set RESEND_API_KEY=your_resend_api_key
#
# Note: RESEND_API_KEY is set as a Supabase secret, not in this file
